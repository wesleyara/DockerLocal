# Porta e host da API. Nunca troque HOST para 0.0.0.0 sem AUTH_TOKEN —
# o app recusa subir (ver ADR-07 em docs/decisoes.md).
PORT=5100
HOST=127.0.0.1

# Socket do daemon Docker.
DOCKER_SOCKET=/var/run/docker.sock

# GID do grupo "docker" NESTA máquina — obtenha com:
#   getent group docker | cut -d: -f3
# Usado só quando o app roda em container (fase 9); no dev local o processo
# já herda os grupos do seu usuário.
DOCKER_GID=973

# Raízes que o file browser pode navegar, separadas por vírgula.
FS_ROOTS=/home/wesley/Documents/development

# Token opcional. Vazio desativa o TokenGuard (uso local single-user).
# Obrigatório se HOST=0.0.0.0.
AUTH_TOKEN=

# Origens permitidas para requests não-GET (anti-CSRF, ver OriginGuard).
# O Vite do apps/web está fixo na porta 5551 (strictPort em vite.config.ts).
# Em container (fase 9), front e API dividem a mesma origem (127.0.0.1:5100)
# — o docker-compose.yml do próprio app já sobrescreve isso.
ALLOWED_ORIGINS=http://localhost:5551,http://127.0.0.1:5551,http://127.0.0.1:5100

# --- Usadas só pelo docker-compose.yml do PRÓPRIO app (fase 9) ---------

# Raiz de projetos espelhada dentro do container, no MESMO caminho absoluto
# dos dois lados — é o que faz bind mounts relativos das stacks alvo
# resolverem certo (ver "Por que espelhado" no backlog da fase 9).
# Normalmente igual a FS_ROOTS.
PROJECTS_ROOT=/home/wesley/Documents/development

# uid:gid do seu usuário no host, pra `user:` no compose — evita que o
# volume /data e os arquivos criados pelo app fiquem com dono root.
#   id -u   /   id -g
APP_UID=1000
APP_GID=1000
