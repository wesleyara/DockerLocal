# Porta e host da API. Nunca troque HOST para 0.0.0.0 sem AUTH_TOKEN —
# o app recusa subir (ver ADR-07 em docs/decisoes.md).
PORT=5100
HOST=127.0.0.1

# Socket do daemon Docker.
DOCKER_SOCKET=/var/run/docker.sock

# GID do grupo "docker" NESTA máquina — obtenha com:
#   getent group docker | cut -d: -f3
# Usado só quando o app roda em container (fase 9); no dev local o processo
# já herda os grupos do seu usuário.
DOCKER_GID=973

# Raízes que o file browser pode navegar, separadas por vírgula.
FS_ROOTS=/home/wesley/Documents/development

# Token opcional. Vazio desativa o TokenGuard (uso local single-user).
# Obrigatório se HOST=0.0.0.0.
AUTH_TOKEN=

# Origens permitidas para requests não-GET (anti-CSRF, ver OriginGuard).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
